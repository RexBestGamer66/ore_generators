scoreboard players remove @e[tag=generator,scores={.cooldown=1..},type=marker] .cooldown 1
schedule function ore_generators:decrease_cooldown 1s
execute as @e[tag=cooldown_display,type=text_display] at @s if score @e[tag=generator,sort=nearest,limit=1,type=marker] .cooldown matches 1000.. run data merge entity @s {text:[{"color":"dark_red","score":{"name":"@e[sort=nearest,limit=1,type=marker]","objective":".cooldown"}},{"color":"dark_red","text":"s"}]}
execute as @e[tag=cooldown_display,type=text_display] at @s if score @e[tag=generator,sort=nearest,limit=1,type=marker] .cooldown matches 500..999 run data merge entity @s {text:[{"color":"red","score":{"name":"@e[sort=nearest,limit=1,type=marker]","objective":".cooldown"}},{"color":"red","text":"s"}]}
